/* Scene 6 — "Ordinary slides in, extraordinary video out. On Pro, a.i. directs your lecture video, timing each
 * scene to your narration. Try Basic first at powerpoint2vid.com."
 * Storyboard: Back to night. On "ordinary slides in" the plain grey slide (the deck's real slide 6) slides in
 * from the left; on "extraordinary video out" it bursts across into a vivid, colour-graded video frame on the
 * right. On "Pro" the pair lifts and a timeline appears; a mint waveform draws, and on "timing each scene" six
 * scene blocks snap onto its pauses, then a playhead runs. On "Try" everything recedes; final hold is
 * "powerpoint2vid.com" at 120px in paper, with the Basic / Pro line in slate beneath. */
P2V.scene((ctx) => {
  const { tl, el, stage } = ctx;
  const A = (i, w) => ctx.at(i, w);
  const tSlides = A(0, 'slides'), tExtra = A(0, 'extraordinary'), tOut = A(0, 'out.');
  const tPro = A(1, 'Pro,'), tAI = A(1, 'A.I.'), tTiming = A(1, 'timing'), tScene = A(1, 'scene'), tNarr = A(1, 'narration.');
  const tTry = A(2, 'Try'), tBasic = A(2, 'Basic'), tPP = A(2, 'PowerPoint'), tCom = A(2, 'com.');
  const MONO = 'ui-monospace, Menlo, monospace';
  const R = ctx.rand(7);

  stage.style.background = 'radial-gradient(60% 55% at 50% 45%, #18213a 0%, var(--night) 75%)';
  const glowA = el('div', 'abs', stage, { left: '-200px', top: '200px', width: '900px', height: '700px', borderRadius: '50%', background: 'radial-gradient(closest-side, rgba(138,147,166,.14), transparent)' });
  const glowB = el('div', 'abs', stage, { left: '1100px', top: '120px', width: '1000px', height: '800px', borderRadius: '50%', background: 'radial-gradient(closest-side, rgba(61,123,255,.22), transparent)', opacity: 0 });

  const cam = el('div', 'abs', stage, { inset: 0, transformOrigin: '960px 540px' });
  const world = el('div', 'abs', cam, { inset: 0, transformOrigin: '960px 500px' });
  const pair = el('div', 'abs', world, { inset: 0 });

  /* ordinary slide */
  const FY = 330, FW = 640, FH = 360;
  const plain = el('div', 'abs', pair, { left: '150px', top: FY + 'px', width: FW + 'px', height: FH + 'px', borderRadius: '8px', overflow: 'hidden', background: '#ddd', boxShadow: '0 30px 70px rgba(0,0,0,.45)' });
  const pimg = el('img', 'abs', plain, { inset: 0, width: '100%', height: '100%' }); pimg.src = ctx.asset('slide-6.png');
  gsap.set(plain, { filter: 'grayscale(1) brightness(.82) contrast(.9) blur(0px)' });
  const labIn = el('div', 'abs', pair, { left: '150px', top: FY + FH + 28 + 'px', font: `600 22px/1 ${MONO}`, letterSpacing: '.14em', color: 'var(--slate)' }); labIn.textContent = 'SLIDES IN';

  /* arrow */
  const arrow = el('div', 'abs', pair, { left: 0, top: 0, width: '1920px', height: '1080px' });
  arrow.innerHTML = `<svg width="1920" height="1080"><path d="M830 ${FY + FH / 2} L1080 ${FY + FH / 2}" stroke="rgba(247,244,238,.5)" stroke-width="4" stroke-linecap="round" stroke-dasharray="2 14"/><path d="M1060 ${FY + FH / 2 - 18} L1082 ${FY + FH / 2} L1060 ${FY + FH / 2 + 18}" fill="none" stroke="rgba(247,244,238,.7)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
  gsap.set(arrow, { clipPath: 'inset(0px 1100px 0px 820px)' });

  /* extraordinary video frame */
  const vid = el('div', 'abs', pair, { left: '1130px', top: FY + 'px', width: FW + 'px', height: FH + 'px', borderRadius: '14px', overflow: 'hidden',
    background: 'radial-gradient(80% 90% at 20% 20%, #3D7BFF 0%, #2a2f8a 40%, #0E1424 85%)', boxShadow: '0 0 90px rgba(61,123,255,.45), 0 40px 90px rgba(0,0,0,.5)', transformOrigin: '30% 50%' });
  el('div', 'abs', vid, { right: '-120px', bottom: '-160px', width: '480px', height: '420px', borderRadius: '50%', background: 'radial-gradient(closest-side, rgba(255,107,87,.75), transparent)' });
  const vt = el('div', 'abs', vid, { left: '44px', top: '58px', width: '560px', font: '800 52px/1.02 Inter Display, Inter', letterSpacing: '-.04em', color: 'var(--paper)' });
  vt.innerHTML = 'Ordinary in.<br><span style="color:#ffb3a6">Extraordinary</span> out.';
  const vbars = [0.4, 0.62, 0.5, 0.86].map((h, i) => el('div', 'abs', vid, { left: 400 + i * 50 + 'px', bottom: '74px', width: '34px', height: h * 120 + 'px', borderRadius: '6px 6px 2px 2px', background: i === 3 ? 'var(--mint)' : 'rgba(247,244,238,.35)', transformOrigin: '50% 100%' }));
  const track = el('div', 'abs', vid, { left: '44px', right: '44px', bottom: '36px', height: '6px', borderRadius: '3px', background: 'rgba(255,255,255,.18)' });
  const prog = el('div', 'abs', track, { left: 0, top: 0, bottom: 0, width: '100%', borderRadius: '3px', background: 'var(--mint)', transformOrigin: '0% 50%' });
  gsap.set(prog, { scaleX: 0 });
  const hd = el('div', 'abs', vid, { right: '24px', top: '22px', font: `700 18px/1 ${MONO}`, letterSpacing: '.12em', color: 'rgba(247,244,238,.75)' }); hd.textContent = '1080p';
  const scan = el('div', 'abs', vid, { top: 0, bottom: 0, left: '-120px', width: '120px', background: 'linear-gradient(90deg, transparent, rgba(60,203,154,.45), transparent)', opacity: 0 });
  const labOut = el('div', 'abs', pair, { left: '1130px', top: FY + FH + 28 + 'px', font: `600 22px/1 ${MONO}`, letterSpacing: '.14em', color: 'var(--mint)' }); labOut.textContent = 'VIDEO OUT';

  /* burst particles */
  const parts = Array.from({ length: 26 }, () => {
    const s = 6 + R() * 10;
    const p = el('div', 'abs', pair, { left: 790 + 'px', top: FY + 40 + R() * (FH - 80) + 'px', width: s + 'px', height: s + 'px', borderRadius: '50%', background: R() > 0.5 ? 'var(--signal)' : (R() > 0.5 ? 'var(--coral)' : 'var(--mint)'), boxShadow: '0 0 14px currentColor', opacity: 0 });
    p._dx = 360 + R() * 300; p._dy = (R() - 0.5) * 160; return p;
  });
  const flash = el('div', 'abs', stage, { inset: 0, background: 'radial-gradient(35% 40% at 75% 47%, rgba(120,160,255,.5), transparent 70%)', opacity: 0, mixBlendMode: 'screen' });

  /* PRO chip */
  const chip = el('div', 'abs', world, { left: '760px', width: '400px', top: '86px', textAlign: 'center' });
  const chipIn = el('div', '', chip, { display: 'inline-block', padding: '12px 26px', borderRadius: '40px', border: '2px solid rgba(60,203,154,.6)', background: 'rgba(60,203,154,.1)', font: `700 24px/1 ${MONO}`, letterSpacing: '.16em', color: 'var(--mint)' });
  chipIn.textContent = 'PRO · AI-DIRECTED';

  /* timeline: blocks + waveform */
  const TX = 260, TW = 1400, TY = 720;
  const seg = [0.18, 0.15, 0.2, 0.14, 0.18, 0.15];
  const bounds = [0]; seg.forEach((s) => bounds.push(bounds[bounds.length - 1] + s));
  const cols = ['#3D7BFF', '#FF6B57', '#3CCB9A', '#3D7BFF', '#FF6B57', '#3CCB9A'];
  const blocks = seg.map((s, i) => {
    const b = el('div', 'abs', world, { left: TX + bounds[i] * TW + 4 + 'px', top: TY + 'px', width: s * TW - 8 + 'px', height: '56px', borderRadius: '10px',
      background: `linear-gradient(180deg, ${cols[i]}, ${cols[i]}aa)`, boxShadow: `0 10px 30px ${cols[i]}44, inset 0 1px 0 rgba(255,255,255,.35)`, opacity: 0 });
    const l = el('div', 'abs', b, { left: '16px', top: '19px', font: `700 18px/1 ${MONO}`, letterSpacing: '.1em', color: 'rgba(255,255,255,.9)' }); l.textContent = 'SCENE ' + (i + 1);
    return b;
  });
  const cv = el('canvas', 'abs', world, { left: TX + 'px', top: TY + 80 + 'px', width: TW + 'px', height: '130px' });
  cv.width = TW; cv.height = 130; const g = cv.getContext('2d');
  const N = 150, amps = Array.from({ length: N }, (_, i) => {
    const f = (i + 0.5) / N; let d = 1; bounds.forEach((bd) => { d = Math.min(d, Math.abs(f - bd)); });
    const env = Math.min(1, d / 0.03); return (0.15 + 0.85 * R()) * env * (0.5 + 0.5 * Math.sin(i * 0.7) ** 2);
  });
  const wv = { p: 0, ph: 0, a: 0 };
  const playhead = el('div', 'abs', world, { left: TX + 'px', top: TY - 14 + 'px', width: '3px', height: '240px', background: 'var(--paper)', boxShadow: '0 0 16px rgba(247,244,238,.8)', opacity: 0 });
  ctx.onFrame(() => {
    g.clearRect(0, 0, TW, 130);
    const bw = TW / N;
    for (let i = 0; i < N; i++) {
      const f = i / N; if (f > wv.p) break;
      const h = Math.max(3, amps[i] * 110);
      g.fillStyle = f < wv.ph ? 'rgba(60,203,154,1)' : 'rgba(60,203,154,.5)';
      g.fillRect(i * bw + 1.5, 65 - h / 2, bw - 3, h);
    }
    playhead.style.transform = `translateX(${wv.ph * TW}px)`;
  });

  /* final CTA */
  const cta = el('div', 'abs', cam, { left: '80px', right: '80px', top: '380px', textAlign: 'center' });
  const url = el('div', '', cta, { font: '800 120px/1 Inter Display, Inter', letterSpacing: '-.04em', color: 'var(--paper)', textShadow: '0 0 60px rgba(61,123,255,.45)' });
  const chars = ctx.split(url, 'powerpoint2vid.com', 'char');
  const uline = el('div', '', cta, { margin: '26px auto 0', width: '760px', height: '5px', borderRadius: '3px', background: 'linear-gradient(90deg, var(--signal), var(--mint))', transformOrigin: '0% 50%', boxShadow: '0 0 20px rgba(60,203,154,.6)' });
  const sub = el('div', '', cta, { marginTop: '34px', font: '600 36px/1.3 Inter', letterSpacing: '-.01em', color: 'var(--slate)' });
  sub.textContent = 'Basic: try it free, watermarked · Pro from A$29 a month';
  const ctaGlow = el('div', 'abs', stage, { left: '460px', top: '250px', width: '1000px', height: '460px', borderRadius: '50%', background: 'radial-gradient(closest-side, rgba(61,123,255,.28), transparent)', opacity: 0 });
  stage.insertBefore(ctaGlow, cam);

  ctx.fx.vignette({ strength: 0.55 });
  ctx.fx.grain({ opacity: 0.06 });

  /* ---- timeline ---- */
  tl.to(cam, { scale: 1.04, duration: ctx.dur, ease: 'none' }, 0);
  tl.from(labIn, { opacity: 0, duration: 0.4 }, 0.05);
  tl.from(plain, { x: -820, rotation: -4, duration: 1.1, ease: 'power3.out' }, 0.2);
  tl.to(arrow, { clipPath: 'inset(0px 820px 0px 820px)', duration: 0.01 }, 0);
  tl.to(arrow, { clipPath: 'inset(0px 0px 0px 820px)', duration: 0.5, ease: 'power2.inOut' }, tExtra - 0.35);

  gsap.set([vid, labOut], { opacity: 0 });
  gsap.set(vid, { filter: 'saturate(0) brightness(.6)' });
  gsap.set(vbars, { scaleY: 0 });
  tl.to(plain, { x: 30, duration: 0.15, yoyo: true, repeat: 1, ease: 'power2.out' }, tExtra - 0.1);
  parts.forEach((p, i) => {
    tl.fromTo(p, { x: 0, y: 0, opacity: 1, scale: 1 }, { x: p._dx, y: p._dy, opacity: 0, scale: 0.3, duration: 0.8, ease: 'power2.out', immediateRender: false }, tExtra + i * 0.012);
  });
  tl.fromTo(vid, { scale: 0.6, x: -260, opacity: 0 }, { scale: 1, x: 0, opacity: 1, duration: 0.7, ease: 'back.out(1.5)', immediateRender: false }, tExtra + 0.05);
  tl.to(vid, { filter: 'saturate(1.15) brightness(1)', duration: 0.9, ease: 'power2.out' }, A(0, 'video') - 0.2);
  tl.to(glowB, { opacity: 1, duration: 1 }, tExtra);
  tl.fromTo(flash, { opacity: 0 }, { opacity: 1, duration: 0.15, yoyo: true, repeat: 1, immediateRender: false }, tExtra + 0.25);
  tl.to(vbars, { scaleY: 1, duration: 0.6, stagger: 0.07, ease: 'back.out(1.8)' }, A(0, 'video'));
  tl.to(labOut, { opacity: 1, duration: 0.4 }, tOut - 0.1);
  tl.to(prog, { scaleX: 1, duration: tTry - tOut, ease: 'none' }, tOut);
  tl.to(plain, { filter: 'grayscale(1) brightness(.6) contrast(.9) blur(0px)', duration: 0.8 }, tOut);

  // Pro: lift the pair, show chip and timeline
  tl.to(pair, { y: -150, scale: 0.94, transformOrigin: '960px 300px', duration: 1, ease: 'expo.inOut' }, tPro - 0.45);
  tl.fromTo(chip, { opacity: 0, y: -20, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: 'back.out(1.7)', immediateRender: false }, tPro);
  gsap.set(chip, { opacity: 0 });
  tl.fromTo(scan, { x: 0, opacity: 1 }, { x: 900, opacity: 1, duration: 0.9, ease: 'power2.inOut', immediateRender: false }, tAI);
  tl.to(wv, { p: 1, duration: tTiming - (tAI + 0.2), ease: 'power1.inOut' }, tAI + 0.2);

  // timing each scene: blocks snap down onto the pauses
  blocks.forEach((b, i) => {
    tl.fromTo(b, { opacity: 0, y: -90, scale: 0.85 }, { opacity: 1, y: 0, scale: 1, duration: 0.5, ease: 'back.out(2)', immediateRender: false }, tTiming + i * ((tNarr - tTiming) / 6));
  });
  tl.to(playhead, { opacity: 1, duration: 0.3 }, tNarr);
  tl.to(wv, { ph: 1, duration: tTry - tNarr, ease: 'none' }, tNarr);
  tl.to(blocks[2], { boxShadow: '0 0 40px rgba(60,203,154,.8), inset 0 1px 0 rgba(255,255,255,.35)', duration: 0.4, yoyo: true, repeat: 1 }, tScene);

  // Try: recede, CTA lands
  gsap.set(world, { filter: 'blur(0px) brightness(1)' });
  tl.to(world, { opacity: 0, scale: 0.9, filter: 'blur(10px) brightness(.6)', duration: 0.9, ease: 'power2.inOut' }, tTry - 0.15);
  tl.to(glowB, { opacity: 0, duration: 0.8 }, tTry);
  tl.to(ctaGlow, { opacity: 1, duration: 1.2 }, tTry + 0.2);
  gsap.set([sub, uline], { opacity: 0 });
  gsap.set(uline, { scaleX: 0 });
  tl.fromTo(chars, { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 0.6, stagger: 0.03, ease: 'back.out(1.6)', immediateRender: false }, tBasic - 0.05);
  gsap.set(chars, { opacity: 0 });
  tl.fromTo(sub, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.7, immediateRender: false }, tPP);
  tl.to(uline, { opacity: 1, scaleX: 1, duration: 0.8, ease: 'expo.out' }, tCom - 0.3);
  tl.to(url, { textShadow: '0 0 90px rgba(61,123,255,.75)', duration: 0.6, yoyo: true, repeat: 1 }, tCom);
});
