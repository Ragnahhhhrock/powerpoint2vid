/* Scene 4 — "Put each video in Moodle, Canvas or Blackboard, right beside the activity that depends on it.
 *  And tell students the viewing time up front: twelve minutes of video before Tuesday."
 * Storyboard: a chalk-tinted stage holds a simplified LMS course page. Its tabs light up in turn and the
 * sidebar brand changes on "Moodle", "Canvas" and "Blackboard". Two short video tiles float in, then snap
 * into the "Before class" column right beside the "In class: apply the ideas" card on "beside". A
 * connector draws on "depends". On "viewing time" the tiles pulse. On "twelve" the camera pushes in as a
 * coral sticky note lands: "Twelve minutes of video before Tuesday", with a clock filling to 12. Hold. */
P2V.scene((ctx) => {
  const { tl, el, stage } = ctx;
  const W = (i, w) => ctx.at(i, w);
  const tMoodle = W(0, 'Moodle,'), tCanvas = W(0, 'Canvas'), tBlack = W(0, 'Blackboard,');
  const tVideo = W(0, 'video'), tBeside = W(0, 'beside'), tActivity = W(0, 'activity'), tDepends = W(0, 'depends');
  const tViewing = W(1, 'viewing'), tTwelve = W(1, 'twelve'), tMinutes = W(1, 'minutes'), tTuesday = W(1, 'Tuesday.');
  const MONO = '600 18px/1 ui-monospace, Menlo, monospace';

  stage.style.background = 'radial-gradient(80% 70% at 55% 40%, #EEF3EF 0%, var(--chalk) 60%, #C9D5CF 100%)';
  const cam = el('div', 'abs', stage, { inset: 0, transformOrigin: '1410px 710px' });

  /* ---- LMS window ---- */
  const win = el('div', 'abs', cam, { left: '200px', top: '130px', width: '1520px', height: '820px', borderRadius: '22px', background: 'var(--paper)', overflow: 'hidden',
    boxShadow: '0 50px 120px rgba(30,36,51,.28), 0 8px 24px rgba(30,36,51,.12)' });
  const bar = el('div', 'abs', win, { left: 0, top: 0, width: '1520px', height: '72px', background: 'var(--ink)' });
  ['#E76F51', '#F2A541', '#2A9D8F'].forEach((c, i) => el('div', 'abs', bar, { left: 26 + i * 26 + 'px', top: '29px', width: '14px', height: '14px', borderRadius: '50%', background: c }));
  const TABS = ['Moodle', 'Canvas', 'Blackboard'];
  const hiTab = el('div', 'abs', bar, { left: '140px', top: '14px', width: '200px', height: '44px', borderRadius: '12px', background: 'var(--paper)', opacity: 0 });
  const tabs = TABS.map((n, i) => {
    const d = el('div', 'abs', bar, { left: 140 + i * 216 + 'px', top: '14px', width: '200px', height: '44px', textAlign: 'center', font: '700 22px/44px Inter', letterSpacing: '-.01em', color: 'rgba(255,255,255,.55)' });
    d.textContent = n; return d;
  });

  const side = el('div', 'abs', win, { left: 0, top: '72px', width: '240px', height: '748px', background: '#E9E6DC' });
  const logo = el('div', 'abs', side, { left: '28px', top: '34px', width: '40px', height: '40px', borderRadius: '10px', background: 'var(--teal)' });
  const brand = el('div', 'abs', side, { left: '80px', top: '42px', font: '800 24px/1 Inter', letterSpacing: '-.02em', color: 'var(--ink)' });
  brand.textContent = 'Course';
  [0, 1, 2, 3, 4].forEach((i) => el('div', 'abs', side, { left: '28px', top: 120 + i * 56 + 'px', width: [150, 120, 170, 110, 140][i] + 'px', height: '14px', borderRadius: '7px', background: i === 2 ? 'rgba(42,157,143,.55)' : 'rgba(30,36,51,.14)' }));

  const wk = el('div', 'abs', win, { left: '300px', top: '118px', font: MONO, letterSpacing: '.14em', color: 'var(--teal)' }); wk.textContent = 'WEEK 3';
  const head = el('div', 'abs', win, { left: '300px', top: '146px', font: '800 50px/1 Inter Display, Inter', letterSpacing: '-.035em', color: 'var(--ink)' }); head.textContent = 'Supply and demand';

  const labB = el('div', 'abs', win, { left: '300px', top: '252px', font: MONO, letterSpacing: '.14em', color: 'rgba(30,36,51,.6)' }); labB.textContent = 'BEFORE CLASS';
  const labI = el('div', 'abs', win, { left: '900px', top: '252px', font: MONO, letterSpacing: '.14em', color: 'rgba(30,36,51,.6)' }); labI.textContent = 'IN CLASS';

  const tiles = [0, 1].map((i) => {
    const t = el('div', 'abs', win, { left: '300px', top: 290 + i * 180 + 'px', width: '520px', height: '150px', borderRadius: '16px', background: '#fff',
      boxShadow: '0 18px 40px rgba(30,36,51,.16)', outline: '0px solid rgba(242,165,65,0)' });
    const th = el('div', 'abs', t, { left: '14px', top: '14px', width: '200px', height: '122px', borderRadius: '10px', background: 'radial-gradient(90% 90% at 30% 20%, #2b3550, var(--night))' });
    el('div', 'abs', th, { left: '84px', top: '42px', width: 0, height: 0, borderTop: '19px solid transparent', borderBottom: '19px solid transparent', borderLeft: '32px solid var(--amber)' });
    const lb = el('div', 'abs', t, { left: '240px', top: '30px', font: MONO, letterSpacing: '.12em', color: 'var(--teal)' }); lb.textContent = 'VIDEO ' + (i + 1);
    el('div', 'abs', t, { left: '240px', top: '66px', width: '230px', height: '16px', borderRadius: '8px', background: 'rgba(30,36,51,.18)' });
    el('div', 'abs', t, { left: '240px', top: '96px', width: '160px', height: '16px', borderRadius: '8px', background: 'rgba(30,36,51,.1)' });
    return t;
  });

  const card = el('div', 'abs', win, { left: '900px', top: '290px', width: '560px', height: '330px', borderRadius: '18px', background: 'var(--ink)', overflow: 'hidden',
    boxShadow: '0 26px 60px rgba(30,36,51,.3)' });
  el('div', 'abs', card, { left: 0, top: 0, width: '10px', height: '330px', background: 'var(--coral)' });
  const cl = el('div', 'abs', card, { left: '44px', top: '44px', font: MONO, letterSpacing: '.14em', color: 'var(--amber)' }); cl.textContent = 'IN CLASS';
  const ct = el('div', 'abs', card, { left: '44px', top: '84px', width: '480px', font: '800 60px/1.05 Inter Display, Inter', letterSpacing: '-.035em', color: '#fff' }); ct.textContent = 'Apply the ideas';
  [0, 1, 2].forEach((i) => {
    el('div', 'abs', card, { left: '44px', top: 236 + i * 26 + 'px', width: '16px', height: '16px', borderRadius: '4px', border: '2px solid rgba(255,255,255,.4)' });
    el('div', 'abs', card, { left: '76px', top: 240 + i * 26 + 'px', width: [260, 320, 220][i] + 'px', height: '10px', borderRadius: '5px', background: 'rgba(255,255,255,.18)' });
  });

  const link = el('div', 'abs', win, { left: 0, top: 0, width: '1520px', height: '820px', pointerEvents: 'none' });
  link.innerHTML = `<svg width="1520" height="820"><path id="ln" d="M822 365 C 860 365, 860 455, 896 455 M822 545 C 860 545, 860 455, 896 455" fill="none" stroke="#2A9D8F" stroke-width="5" stroke-linecap="round" stroke-dasharray="400" stroke-dashoffset="400"/></svg>`;
  const ln = link.querySelector('#ln');

  /* ---- sticky note ---- */
  const note = el('div', 'abs', cam, { left: '1180px', top: '520px', width: '460px', height: '380px', borderRadius: '6px', background: 'linear-gradient(170deg, #FFF1C9 0%, #FBE2A4 100%)',
    boxShadow: '0 40px 80px rgba(30,36,51,.35), 0 4px 10px rgba(30,36,51,.15)', transformOrigin: '50% 0%' });
  el('div', 'abs', note, { left: '170px', top: '-16px', width: '120px', height: '34px', background: 'rgba(42,157,143,.35)', transform: 'rotate(-2deg)' });
  const clockBox = el('div', 'abs', note, { left: '36px', top: '40px', width: '110px', height: '110px' });
  clockBox.innerHTML = `<svg width="110" height="110" viewBox="0 0 110 110">
    <circle cx="55" cy="55" r="48" fill="#fff" stroke="#E76F51" stroke-width="5"/>
    <circle id="pie" cx="55" cy="55" r="22" fill="none" stroke="rgba(231,111,81,.55)" stroke-width="44" stroke-dasharray="0 200" transform="rotate(-90 55 55)"/>
    <line id="hand" x1="55" y1="55" x2="55" y2="14" stroke="#1E2433" stroke-width="5" stroke-linecap="round"/>
    <circle cx="55" cy="55" r="5" fill="#1E2433"/></svg>`;
  const pie = clockBox.querySelector('#pie'), hand = clockBox.querySelector('#hand');
  const minLab = el('div', 'abs', note, { left: '166px', top: '78px', font: '800 40px/1 Inter', letterSpacing: '-.02em', color: 'var(--coral)', fontVariantNumeric: 'tabular-nums' });
  const nt = el('div', 'abs', note, { left: '38px', top: '178px', width: '390px', font: 'italic 700 46px/1.12 Inter Display, Inter', letterSpacing: '-.03em', color: 'var(--coral)' });
  nt.textContent = 'Twelve minutes of video before Tuesday';
  const underline = el('div', 'abs', note, { left: '38px', top: '336px', width: '190px', height: '5px', borderRadius: '3px', background: 'var(--coral)', transformOrigin: '0 50%' });

  ctx.fx.vignette({ strength: 0.3 });
  ctx.fx.grain({ opacity: 0.06 });

  const clock = { m: 0 };
  const C = 2 * Math.PI * 22;
  ctx.onFrame((t) => {
    brand.textContent = t < tMoodle ? 'Course' : t < tCanvas ? 'Moodle' : t < tBlack ? 'Canvas' : 'Blackboard';
    pie.setAttribute('stroke-dasharray', `${(clock.m / 60) * C} 200`);
    hand.setAttribute('transform', `rotate(${clock.m * 6} 55 55)`);
    minLab.textContent = Math.round(clock.m) + ' MIN';
  });

  /* ---- timeline ---- */
  tl.to(cam, { x: -14, y: -8, duration: ctx.dur, ease: 'none' }, 0);
  tl.from(win, { y: 50, opacity: 0, scale: 0.97, duration: 0.8 }, 0.02);
  tl.from([wk, head], { y: 20, opacity: 0, duration: 0.6, stagger: 0.08 }, 0.35);
  tl.from([labB, labI], { opacity: 0, duration: 0.5 }, 0.6);

  // tabs light up in turn
  [tMoodle, tCanvas, tBlack].forEach((tt, i) => {
    if (i === 0) tl.to(hiTab, { opacity: 1, duration: 0.2 }, tt - 0.05);
    else tl.to(hiTab, { x: i * 216, duration: 0.35, ease: 'back.out(1.6)' }, tt - 0.08);
    tl.to(tabs[i], { color: '#1E2433', duration: 0.15 }, tt - 0.05);
    if (i > 0) tl.to(tabs[i - 1], { color: 'rgba(255,255,255,.55)', duration: 0.15 }, tt - 0.05);
    tl.fromTo([brand, logo], { opacity: 0.1 }, { opacity: 1, duration: 0.25, ease: 'power1.out', immediateRender: false }, tt);
    tl.fromTo(logo, { scale: 0.6 }, { scale: 1, duration: 0.4, ease: 'back.out(2)', immediateRender: false }, tt);
  });
  tl.to(logo, { background: '#F2A541', duration: 0.2 }, tCanvas);
  tl.to(logo, { background: '#E76F51', duration: 0.2 }, tBlack);

  // video tiles float in, then snap beside the activity
  tiles.forEach((tile, i) => {
    tl.fromTo(tile, { opacity: 0, x: 260 + i * 40, y: 180, rotation: i ? 5 : -4, scale: 1.04 },
      { opacity: 1, y: 120 - i * 30, duration: 0.7, ease: 'back.out(1.4)' }, tVideo - 0.1 + i * 0.12);
    tl.to(tile, { y: '-=16', duration: 1.2, ease: 'sine.inOut', yoyo: true, repeat: 1 }, tVideo + 0.7);
    tl.to(tile, { x: 0, y: 0, rotation: 0, scale: 1, duration: 0.55, ease: 'back.out(1.7)' }, tBeside - 0.1 + i * 0.08);
  });
  tl.from(card, { x: 140, opacity: 0, duration: 0.7, ease: 'back.out(1.3)' }, tBeside - 0.55);
  tl.fromTo(card, { scale: 1 }, { scale: 1.04, duration: 0.25, yoyo: true, repeat: 1, ease: 'power2.out', immediateRender: false }, tActivity);
  tl.to(ln, { attr: { 'stroke-dashoffset': 0 }, duration: 0.7, ease: 'power2.inOut' }, tDepends - 0.2);

  // viewing time: tiles pulse amber
  tl.to(tiles, { outline: '5px solid rgba(242,165,65,1)', duration: 0.3, stagger: 0.1 }, tViewing - 0.1);

  // twelve minutes: push in, note lands
  tl.to(cam, { scale: 1.22, duration: 1.7, ease: 'expo.inOut' }, tTwelve - 0.6);
  tl.to(win, { filter: 'blur(0px) brightness(.92)', duration: 1.2 }, tTwelve - 0.3);
  gsap.set(win, { filter: 'blur(0px) brightness(1)' });
  tl.fromTo(note, { opacity: 0, y: -120, rotation: 8, scale: 1.15 }, { opacity: 1, y: 0, rotation: -3, scale: 1, duration: 0.6, ease: 'back.out(1.6)' }, tTwelve - 0.25);
  tl.to(clock, { m: 12, duration: 1.1, ease: 'power2.out' }, tMinutes - 0.1);
  tl.from(underline, { scaleX: 0, duration: 0.45, ease: 'power2.out' }, tTuesday);
  tl.to(note, { rotation: -2, y: -6, duration: ctx.dur - tTuesday, ease: 'sine.inOut' }, tTuesday);
});
