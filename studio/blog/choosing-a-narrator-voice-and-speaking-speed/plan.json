    {
      "file": "scenes/scene-2.js",
      "narration": "Speed matters as much as the voice. Too slow feels patronising, too fast loses people. If captions flick past, slow down; if you want to skip, speed up.",
      "storyboard": "Ink stage with a large horizontal speed dial spanning the frame, marker centred on 'default'. On 'too slow' the marker drags left and the zone glows coral; on 'too fast' it whips right and blurs. On 'captions flick past' a caption strip races by and the marker eases back slightly left; on 'speed up' it nudges right. The four content types sit as small labels on the dial: Dense, Policy, Product, Social at their deck positions.",
      "minDuration": 11,
      "slide": {
        "title": "Set the speed for the content",
        "text": "Dense material: a little slower than default. Policy and instructions: default or slightly slower. Product overviews: default. Social clips: default or slightly faster",
        "notes": "Speed matters as much as the voice. Too slow feels patronising, too fast loses people. If captions flick past, slow down; if you want to skip, speed up.",
        "image": "assets/slide-3.png"
      },
