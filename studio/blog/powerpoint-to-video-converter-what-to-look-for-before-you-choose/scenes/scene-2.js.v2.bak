/* Scene 2 — "Next, narration: record it or write it. If your deck changes often, narration from your
 * speaker notes is easier, because fixing a sentence means editing text, not re-recording."
 * Storyboard: night stage, split screen. Left: a microphone with a long waveform that draws in on
 * "record it". Right: a paper notes page whose lines write in, with a blinking cursor, on "write it".
 * On "changes often" a slide card flips v1→v2 and the waveform shatters, then has to redraw slowly
 * from scratch. The notes page glows teal on "speaker notes" and an EASIER badge pops on "easier".
 * On "editing text" the camera pushes into the notes, "March" is swapped for "April" in teal, and
 * "Edit text, not re-record" lands at 120px on "not". Hold. */
P2V.scene((ctx) => {
  const { tl, el, stage } = ctx;
  const A = (i, w, f) => { const v = ctx.at(i, w); return (typeof v === 'number' && isFinite(v)) ? v : f; };
  const tNarr = A(0, 'narration:', 0.98), tRec = A(0, 'record', 2.106), tWrite = A(0, 'write', 2.814);
  const tChanges = A(1, 'changes', 4.614), tOften = A(1, 'often,', 5.055), tNotes = A(1, 'speaker', 6.506);
  const tEasier = A(1, 'easier,', 7.342), tFix = A(1, 'fixing', 8.282), tEdit = A(1, 'editing', 9.548);
  const tText = A(1, 'text,', 10.012), tNot = A(1, 'not', 10.732);
  const rnd = ctx.rand(23);
  const MONO = 'ui-monospace, Menlo, monospace';

  stage.style.background = 'radial-gradient(60% 55% at 30% 45%, #1b2238 0%, transparent 70%), radial-gradient(55% 55% at 75% 50%, #15283a 0%, transparent 70%), var(--night)';
  const drift = el('div', 'abs', stage, { inset: 0, transformOrigin: '960px 540px' });
  const cam = el('div', 'abs', drift, { inset: 0, transformOrigin: '1410px 480px' });

  const hdr = el('div', 'abs', cam, { left: '120px', top: '96px', font: `600 22px/1 ${MONO}`, letterSpacing: '.18em', color: 'var(--mist)' });
  hdr.textContent = 'STEP 2 · NARRATION';

  const flipBox = el('div', 'abs', cam, { left: '880px', top: '58px', width: '160px', height: '96px' });
  const mkFace = (txt, col) => {
    const f = el('div', 'abs', flipBox, { inset: 0, borderRadius: '10px', background: 'var(--paper)', boxShadow: '0 16px 40px rgba(0,0,0,.45)', overflow: 'hidden' });
    el('div', 'abs', f, { left: '14px', top: '14px', width: '90px', height: '10px', borderRadius: '5px', background: 'rgba(26,31,46,.5)' });
    el('div', 'abs', f, { left: '14px', top: '34px', width: '120px', height: '6px', borderRadius: '3px', background: 'rgba(26,31,46,.25)' });
    el('div', 'abs', f, { left: '14px', top: '48px', width: '100px', height: '6px', borderRadius: '3px', background: 'rgba(26,31,46,.25)' });
    const v = el('div', 'abs', f, { right: '12px', bottom: '10px', font: `800 24px/1 Inter`, color: col }); v.textContent = txt;
    return f;
  };
  const face1 = mkFace('v1', 'var(--ink)'), face2 = mkFace('v2', 'var(--signal)');
  const flipTag = el('div', 'abs', cam, { left: '760px', width: '400px', top: '166px', textAlign: 'center', font: `700 18px/1 ${MONO}`, letterSpacing: '.16em', color: 'var(--amber)' });
  flipTag.textContent = 'DECK CHANGED';

  const left = el('div', 'abs', cam, { left: '120px', top: '200px', width: '780px', height: '560px', borderRadius: '28px', background: 'linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02))', border: '1px solid rgba(255,255,255,.08)', boxShadow: '0 40px 90px rgba(0,0,0,.4)' });
  const micGlow = el('div', 'abs', left, { left: '250px', top: '20px', width: '280px', height: '280px', borderRadius: '50%', background: 'radial-gradient(circle, rgba(255,107,74,.35), transparent 65%)', opacity: 0 });
  const rings = [0, 1].map(() => el('div', 'abs', left, { left: '310px', top: '80px', width: '160px', height: '160px', borderRadius: '50%', border: '3px solid var(--signal)', opacity: 0 }));
  const mic = el('div', 'abs', left, { left: '310px', top: '50px', width: '160px', height: '220px' });
  mic.innerHTML = `<svg width="160" height="220" viewBox="0 0 160 220"><rect x="48" y="8" width="64" height="120" rx="32" fill="#e8ebf2"/>
    <g stroke="#9AA3B5" stroke-width="3" stroke-linecap="round"><line x1="60" y1="40" x2="100" y2="40"/><line x1="60" y1="58" x2="100" y2="58"/><line x1="60" y1="76" x2="100" y2="76"/></g>
    <path d="M28 96 Q28 160 80 160 Q132 160 132 96" fill="none" stroke="#e8ebf2" stroke-width="8" stroke-linecap="round"/>
    <line x1="80" y1="160" x2="80" y2="196" stroke="#e8ebf2" stroke-width="8"/><line x1="50" y1="200" x2="110" y2="200" stroke="#e8ebf2" stroke-width="8" stroke-linecap="round"/></svg>`;
  const recDot = el('div', 'abs', left, { left: '40px', top: '36px', font: `700 20px/1 ${MONO}`, letterSpacing: '.14em', color: 'var(--signal)', opacity: 0 });
  recDot.textContent = '● REC';
  const wave = el('div', 'abs', left, { left: '38px', top: '310px', width: '704px', height: '180px' });
  const N = 64;
  const bars = [];
  for (let i = 0; i < N; i++) {
    const env = Math.sin((i / (N - 1)) * Math.PI) * 0.6 + 0.4;
    const h = 16 + env * (30 + rnd() * 120);
    bars.push(el('div', 'abs', wave, { left: i * 11 + 'px', top: 90 - h / 2 + 'px', width: '6px', height: h + 'px', borderRadius: '3px', background: 'linear-gradient(180deg, #ffb199, #FF6B4A)', boxShadow: '0 0 12px rgba(255,107,74,.45)', transformOrigin: '50% 50%' }));
  }
  const playhead = el('div', 'abs', wave, { left: '0px', top: '0px', width: '3px', height: '180px', background: '#fff', boxShadow: '0 0 14px rgba(255,255,255,.8)', opacity: 0 });
  const againTag = el('div', 'abs', left, { left: '0', width: '780px', top: '506px', textAlign: 'center', font: `700 20px/1 ${MONO}`, letterSpacing: '.16em', color: 'var(--signal)', opacity: 0 });
  againTag.textContent = 'RECORD IT ALL AGAIN';
  const capL = el('div', 'abs', cam, { left: '120px', width: '780px', top: '800px', textAlign: 'center', font: '800 48px/1 Inter Display, Inter', letterSpacing: '-.03em', color: '#fff' });
  capL.textContent = 'Record it';

  const right = el('div', 'abs', cam, { left: '1020px', top: '200px', width: '780px', height: '560px', borderRadius: '28px', background: 'var(--paper)', boxShadow: '0 40px 90px rgba(0,0,0,.45)', overflow: 'hidden' });
  const rGlow = el('div', 'abs', cam, { left: '1020px', top: '200px', width: '780px', height: '560px', borderRadius: '28px', border: '4px solid var(--teal)', boxShadow: '0 0 70px rgba(43,181,163,.55)', opacity: 0, boxSizing: 'border-box' });
  const nHead = el('div', 'abs', right, { left: '56px', top: '48px', font: `700 20px/1 ${MONO}`, letterSpacing: '.18em', color: 'rgba(26,31,46,.55)' });
  nHead.textContent = 'SPEAKER NOTES';
  const lineBox = el('div', 'abs', right, { left: '56px', top: '110px', width: '668px' });
  const mkLine = (i) => el('div', 'abs', lineBox, { left: 0, top: i * 84 + 'px', whiteSpace: 'nowrap', font: '600 40px/60px Inter', letterSpacing: '-.01em', color: 'var(--ink)' });
  const L1 = mkLine(0); L1.textContent = 'Welcome, everyone.';
  const L2 = mkLine(1); L2.textContent = 'Today we cover the new plan.';
  const L3 = mkLine(2);
  const L4 = mkLine(3);
  const hl = el('div', 'abs', lineBox, { left: '-10px', top: 2 * 84 - 4 + 'px', width: '560px', height: '68px', borderRadius: '10px', background: 'rgba(245,184,65,.28)', opacity: 0, transformOrigin: '0% 50%' });
  lineBox.insertBefore(hl, L1);
  L3.appendChild(document.createTextNode('It launches in '));
  const oldW = el('span', '', L3, { display: 'inline-block', verticalAlign: 'top', overflow: 'hidden', whiteSpace: 'nowrap', maxWidth: '260px', background: 'rgba(255,107,74,0)', borderRadius: '6px' }); oldW.textContent = 'March';
  const newW = el('span', '', L3, { display: 'inline-block', verticalAlign: 'top', overflow: 'hidden', whiteSpace: 'nowrap', maxWidth: '0px', color: 'var(--teal)', fontWeight: 800 });
  const newChars = ctx.split(newW, 'April', 'char');
  const cur2 = el('span', '', L3, { display: 'inline-block', width: '4px', height: '44px', background: 'var(--teal)', verticalAlign: '-8px', marginLeft: '3px', opacity: 0 });
  L3.appendChild(document.createTextNode('.'));
  L4.appendChild(document.createTextNode('Questions at the end.'));
  const cur1 = el('span', '', L4, { display: 'inline-block', width: '4px', height: '44px', background: 'var(--ink)', verticalAlign: '-8px', marginLeft: '6px' });
  const lines = [L1, L2, L3, L4];
  const badge = el('div', 'abs', right, { right: '40px', top: '34px', padding: '12px 20px', borderRadius: '40px', background: 'var(--teal)', color: '#fff', font: `800 22px/1 ${MONO}`, letterSpacing: '.14em', boxShadow: '0 10px 30px rgba(43,181,163,.45)' });
  badge.textContent = '✓ EASIER';
  const capR = el('div', 'abs', cam, { left: '1020px', width: '780px', top: '800px', textAlign: 'center', font: '800 48px/1 Inter Display, Inter', letterSpacing: '-.03em', color: '#fff' });
  capR.textContent = 'Write it';

  const scrim = el('div', 'abs', stage, { left: 0, right: 0, bottom: 0, height: '360px', background: 'linear-gradient(0deg, rgba(14,18,32,.96) 35%, rgba(14,18,32,0))', opacity: 0 });
  const head = el('div', 'abs', stage, { left: '80px', width: '1760px', top: '862px', textAlign: 'center', font: '900 120px/1 Inter Display, Inter', letterSpacing: '-.045em', color: '#fff', whiteSpace: 'nowrap', transformOrigin: '50% 60%' });
  head.innerHTML = '<span style="color:var(--teal)">Edit text,</span> not re-record';

  ctx.fx.vignette({ strength: 0.5 });
  ctx.fx.grain({ opacity: 0.06 });

  ctx.onFrame((t) => {
    const on = Math.floor(t * 2.2) % 2 === 0 ? 1 : 0;
    const editing = t >= tEdit + 0.1;
    cur1.style.opacity = (t > tWrite + 0.6 && !editing) ? on : 0;
    cur2.style.opacity = editing ? (t < tText + 0.5 ? 1 : on) : 0;
  });

  gsap.set(bars, { scaleY: 0 });
  gsap.set(lines, { clipPath: 'inset(0% 100% 0% 0%)' });
  gsap.set(newChars, { opacity: 0, y: 14 });
  gsap.set(face2, { scaleX: 0 });
  gsap.set([flipBox, flipTag, badge, head, capL, capR], { opacity: 0 });
  gsap.set(cam, { filter: 'brightness(1)' });

  tl.to(drift, { scale: 1.03, duration: ctx.dur, ease: 'none' }, 0);
  tl.from(hdr, { opacity: 0, x: -20, duration: 0.6 }, 0.1);
  tl.from(left, { opacity: 0, x: -60, duration: 0.9 }, 0.05);
  tl.from(right, { opacity: 0, x: 60, duration: 0.9 }, 0.15);
  tl.from(mic, { opacity: 0, y: 30, scale: 0.85, duration: 0.8, ease: 'back.out(1.6)' }, tNarr - 0.2);
  tl.from(nHead, { opacity: 0, y: 10, duration: 0.5 }, tNarr);

  tl.to(capL, { opacity: 1, duration: 0.1 }, tRec - 0.05);
  tl.from(capL, { y: 24, scale: 0.9, duration: 0.5, ease: 'back.out(1.8)' }, tRec - 0.05);
  tl.to(micGlow, { opacity: 1, duration: 0.4 }, tRec);
  tl.to(recDot, { opacity: 1, duration: 0.2 }, tRec);
  rings.forEach((r, i) => tl.fromTo(r, { scale: 0.9, opacity: 0.8 }, { scale: 1.9, opacity: 0, duration: 1.1, ease: 'power2.out', repeat: 2, immediateRender: false }, tRec + i * 0.55));
  tl.to(bars, { scaleY: 1, duration: 0.45, ease: 'back.out(2)', stagger: 0.022 }, tRec);

  tl.to(capR, { opacity: 1, duration: 0.1 }, tWrite - 0.05);
  tl.from(capR, { y: 24, scale: 0.9, duration: 0.5, ease: 'back.out(1.8)' }, tWrite - 0.05);
  tl.to(lines, { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.5, ease: 'power2.out', stagger: 0.18 }, tWrite);

  tl.fromTo(flipBox, { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.4, immediateRender: false }, tChanges - 0.35);
  tl.to(face1, { scaleX: 0, duration: 0.18, ease: 'power2.in' }, tChanges);
  tl.to(face2, { scaleX: 1, duration: 0.22, ease: 'back.out(2)' }, tChanges + 0.18);
  tl.to(flipTag, { opacity: 1, duration: 0.3 }, tChanges + 0.2);
  tl.to(left, { borderColor: 'rgba(255,107,74,.6)', duration: 0.1, yoyo: true, repeat: 1 }, tOften);
  bars.forEach((b) => {
    tl.to(b, { x: (rnd() - 0.5) * 420, y: (rnd() - 0.5) * 520, rotation: (rnd() - 0.5) * 360, opacity: 0, duration: 0.8 + rnd() * 0.3, ease: 'power2.out' }, tOften + rnd() * 0.08);
  });
  tl.to([recDot, micGlow], { opacity: 0, duration: 0.3 }, tOften);
  const redo = tOften + 1.0, redoDur = N * 0.06;
  tl.set(bars, { x: 0, y: 0, rotation: 0, opacity: 1, scaleY: 0 }, redo);
  tl.to(againTag, { opacity: 1, duration: 0.3 }, redo - 0.2);
  tl.to(playhead, { opacity: 1, duration: 0.2 }, redo);
  tl.to(playhead, { x: 700, duration: redoDur, ease: 'none' }, redo);
  tl.to(bars, { scaleY: 1, duration: 0.3, ease: 'power2.out', stagger: 0.06 }, redo);
  tl.to(recDot, { opacity: 1, duration: 0.2 }, redo);

  tl.to(rGlow, { opacity: 1, duration: 0.5 }, tNotes);
  tl.to(capR, { color: 'var(--teal)', duration: 0.4 }, tNotes);
  tl.to(badge, { opacity: 1, duration: 0.1 }, tEasier - 0.05);
  tl.from(badge, { scale: 0.4, rotation: -8, duration: 0.55, ease: 'back.out(2)' }, tEasier - 0.05);

  tl.fromTo(hl, { opacity: 1, scaleX: 0 }, { scaleX: 1, duration: 0.5, ease: 'power2.out', immediateRender: false }, tFix);
  tl.to(oldW, { backgroundColor: 'rgba(255,107,74,.25)', duration: 0.3 }, tFix + 0.45);

  tl.to(cam, { scale: 1.28, x: -450, duration: 1.2, ease: 'expo.inOut' }, tEdit - 0.3);
  tl.to([left, capL, hdr], { opacity: 0.15, duration: 0.6 }, tEdit - 0.2);
  tl.to([flipBox, flipTag], { opacity: 0, duration: 0.5 }, tEdit - 0.3);
  tl.to([capR, capL], { opacity: 0, duration: 0.3 }, tEdit - 0.3);
  tl.to(oldW, { opacity: 0, y: -24, duration: 0.25, ease: 'power2.in' }, tEdit + 0.05);
  tl.to(oldW, { maxWidth: '0px', duration: 0.3, ease: 'power2.inOut' }, tEdit + 0.25);
  tl.to(newW, { maxWidth: '260px', duration: 0.35, ease: 'power2.out' }, tText - 0.25);
  tl.to(newChars, { opacity: 1, y: 0, duration: 0.25, ease: 'back.out(2.5)', stagger: 0.07 }, tText - 0.2);
  tl.to(hl, { backgroundColor: 'rgba(43,181,163,.22)', duration: 0.4 }, tText);

  tl.to(scrim, { opacity: 1, duration: 0.4 }, tNot - 0.5);
  tl.fromTo(head, { opacity: 0, scale: 1.5, y: -10 }, { opacity: 1, scale: 1, y: 0, duration: 0.4, ease: 'power4.in', immediateRender: false }, tNot - 0.32);
  tl.to(head, { y: 5, duration: 0.07, yoyo: true, repeat: 1 }, tNot + 0.08);
  tl.to(cam, { scale: 1.31, duration: ctx.dur - tNot, ease: 'power1.out' }, tNot + 0.3);
  tl.to(rGlow, { boxShadow: '0 0 110px rgba(43,181,163,.8)', duration: 0.6, yoyo: true, repeat: 1 }, tNot + 0.1);
});
