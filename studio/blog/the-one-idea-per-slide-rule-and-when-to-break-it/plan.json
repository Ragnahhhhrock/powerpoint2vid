      "file": "scenes/scene-1.js",
      "narration": "Here's a typical crowded slide. A vague headline, and four separate ideas fighting for attention. Split it, and each point gets its own headline.",
      "minDuration": 11,
      "slide": {
        "title": "Q3 update",
        "text": "Revenue up on last quarter. Two new enterprise customers signed. Churn rose in the small-business segment. Hiring two more account managers",
