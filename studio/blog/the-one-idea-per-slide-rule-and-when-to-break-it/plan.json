      "file": "scenes/scene-3.js",
      "narration": "It's a default, not a law. Break it for comparisons, summaries, reference slides and process diagrams, where seeing several things together is the whole point.",
      "minDuration": 10,
      "slide": {
        "title": "When to break the rule",
        "text": "Comparisons. Summaries and agendas. Reference slides. Process diagrams",
        "notes": "It's a default, not a law. Break it for comparisons, summaries, reference slides and process diagrams, where seeing several things together is the whole point.",
