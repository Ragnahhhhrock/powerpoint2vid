/* Scene 4: "Preview what's coming, mark each transition, then recap. It feels repetitive on paper.
 * In audio, it's what keeps people with you."
 * Storyboard: ink stage with a horizontal route line and three signposts. Teal signs rise on "Preview",
 * "transition" and "recap" while a glowing dot travels the route. On "repetitive on paper" a paper card
 * flashes in, showing the same three signs gone dull. On "audio" the card drops away. On "keeps people with you"
 * the dot runs to the end of the route, and a cluster of listener dots follows it, warming from teal to amber. */
P2V.scene((ctx) => {
  const { tl, el, stage } = ctx;
  const tPrev = ctx.at(0, 'Preview'), tTrans = ctx.at(0, 'transition'), tRecap = ctx.at(0, 'recap');
  const tRep = ctx.at(1, 'repetitive'), tPaper = ctx.at(1, 'paper');
  const tAudio = ctx.at(2, 'audio'), tKeeps = ctx.at(2, 'keeps'), tPeople = ctx.at(2, 'people'), tYou = ctx.at(2, 'you');
  const RY = 700, RX0 = 200, RX1 = 1720;
  const SIGNS = [['PREVIEW', 520, tPrev], ['TRANSITION', 960, tTrans], ['RECAP', 1400, tRecap]];
  const MONO = 'ui-monospace, Menlo, monospace';

  stage.style.background = 'radial-gradient(70% 60% at 50% 62%, #252e44 0%, var(--ink) 45%, var(--night) 100%)';
  const cam = el('div', 'abs', stage, { inset: 0, transformOrigin: '960px 640px' });
  gsap.set(cam, { filter: 'brightness(1) blur(0px)' });

  // soft teal floor light
  el('div', 'abs', cam, { left: '160px', width: '1600px', top: RY - 220 + 'px', height: '440px', background: 'radial-gradient(50% 50% at 50% 50%, rgba(79,209,197,.12), transparent 70%)' });

  const title = el('div', 'abs', cam, { left: '160px', top: '130px', font: '800 76px/1 Inter Display, Inter', letterSpacing: '-.04em', color: 'var(--paper)' });
  title.textContent = 'Tell listeners where they are';
  const kicker = el('div', 'abs', cam, { left: '164px', top: '96px', font: `600 20px/1 ${MONO}`, letterSpacing: '.18em', color: 'var(--mist)' });
  kicker.textContent = 'SIGNPOSTING';

  // route
  const route = el('div', 'abs', cam, { left: RX0 + 'px', width: RX1 - RX0 + 'px', top: RY - 2 + 'px', height: '4px', borderRadius: '2px', transformOrigin: '0% 50%',
    background: 'linear-gradient(90deg, rgba(154,164,184,.25), rgba(154,164,184,.6) 50%, rgba(154,164,184,.25))' });
  const routeLit = el('div', 'abs', cam, { left: RX0 + 'px', width: RX1 - RX0 + 'px', top: RY - 2 + 'px', height: '4px', borderRadius: '2px', transformOrigin: '0% 50%',
    background: 'var(--waveform)', boxShadow: '0 0 18px rgba(79,209,197,.7)' });
  const endCap = el('div', 'abs', cam, { left: RX1 - 14 + 'px', top: RY - 14 + 'px', width: '28px', height: '28px', borderRadius: '50%', border: '3px solid rgba(154,164,184,.6)', boxSizing: 'border-box' });

  // signposts
  const signs = SIGNS.map(([label, x, t]) => {
    const wrap = el('div', 'abs', cam, { left: x - 140 + 'px', top: RY - 240 + 'px', width: '280px', height: '240px', transformOrigin: '50% 100%' });
    el('div', 'abs', wrap, { left: '137px', top: '60px', width: '6px', height: '180px', borderRadius: '3px', background: 'linear-gradient(180deg, #cfd6e4, #6b7590)' });
    const panel = el('div', 'abs', wrap, { left: '0px', top: '0px', width: '280px', height: '80px', background: 'linear-gradient(180deg, #7fe6dc, var(--waveform))',
      clipPath: 'polygon(0 0, 88% 0, 100% 50%, 88% 100%, 0 100%)', display: 'flex', alignItems: 'center', paddingLeft: '26px', boxSizing: 'border-box',
      font: `800 26px/1 ${MONO}`, letterSpacing: '.1em', color: 'var(--night)' });
    panel.textContent = label;
    const glow = el('div', 'abs', wrap, { left: '-20px', top: '-20px', width: '320px', height: '120px', borderRadius: '30px', background: 'radial-gradient(50% 50% at 45% 50%, rgba(79,209,197,.45), transparent 70%)', zIndex: -1 });
    const ring = el('div', 'abs', cam, { left: x - 40 + 'px', top: RY - 40 + 'px', width: '80px', height: '80px', borderRadius: '50%', border: '4px solid var(--waveform)', boxSizing: 'border-box', opacity: 0 });
    const node = el('div', 'abs', cam, { left: x - 9 + 'px', top: RY - 9 + 'px', width: '18px', height: '18px', borderRadius: '50%', background: '#cfd6e4' });
    return { wrap, panel, glow, ring, node, x, t };
  });

  // listener dots
  const R = ctx.rand(7);
  const listeners = Array.from({ length: 16 }, (_, i) => {
    const d = el('div', 'abs', cam, { left: '0px', top: '0px', width: '16px', height: '16px', borderRadius: '50%', background: 'var(--waveform)', boxShadow: '0 0 14px rgba(79,209,197,.6)', opacity: 0 });
    const ang = R() * Math.PI * 2, rad = 30 + R() * 70;
    return { d, ox: Math.cos(ang) * rad - 60 - R() * 40, oy: Math.sin(ang) * rad * 0.55, i };
  });

  // hero dot
  const dot = el('div', 'abs', cam, { left: RX0 - 16 + 'px', top: RY - 16 + 'px', width: '32px', height: '32px', borderRadius: '50%', background: '#e9fffc',
    boxShadow: '0 0 0 6px rgba(79,209,197,.35), 0 0 40px 10px rgba(79,209,197,.8)' });

  // paper card
  const flash = el('div', 'abs', stage, { inset: 0, background: 'var(--paper)', opacity: 0 });
  const card = el('div', 'abs', stage, { left: '460px', top: '260px', width: '1000px', height: '560px', borderRadius: '18px', background: 'var(--paper)',
    boxShadow: '0 60px 120px rgba(0,0,0,.55)', opacity: 0, transformOrigin: '50% 60%' });
  const cardTag = el('div', 'abs', card, { left: '60px', top: '56px', font: `700 22px/1 ${MONO}`, letterSpacing: '.18em', color: '#9b9384' });
  cardTag.textContent = 'ON PAPER';
  el('div', 'abs', card, { left: '80px', width: '840px', top: '402px', height: '3px', background: '#d8d0c0' });
  [['PREVIEW', 230], ['TRANSITION', 500], ['RECAP', 770]].forEach(([l, x]) => {
    el('div', 'abs', card, { left: x - 2 + 'px', top: '300px', width: '4px', height: '102px', background: '#cbc3b2' });
    const p = el('div', 'abs', card, { left: x - 110 + 'px', top: '236px', width: '220px', height: '64px', background: '#e4ddcf', clipPath: 'polygon(0 0, 88% 0, 100% 50%, 88% 100%, 0 100%)',
      display: 'flex', alignItems: 'center', paddingLeft: '20px', boxSizing: 'border-box', font: `700 20px/1 ${MONO}`, letterSpacing: '.08em', color: '#a69e8e' });
    p.textContent = l;
  });
  const cardWord = el('div', 'abs', card, { left: '60px', top: '110px', font: '800 64px/1 Inter Display, Inter', letterSpacing: '-.04em', color: 'var(--ink)' });
  cardWord.textContent = 'Repetitive?';

  ctx.fx.vignette({ strength: 0.5 });
  ctx.fx.grain({ opacity: 0.06 });

  /* ---- timeline ---- */
  // open
  tl.from(title, { y: 30, opacity: 0, duration: 0.7 }, 0.05);
  tl.from(kicker, { opacity: 0, duration: 0.5 }, 0.15);
  tl.from(route, { scaleX: 0, duration: 1.2, ease: 'expo.inOut' }, 0);
  tl.from(endCap, { scale: 0, opacity: 0, duration: 0.5, ease: 'back.out(2)' }, 0.9);
  tl.from(dot, { scale: 0, duration: 0.5, ease: 'back.out(2)' }, 0.1);
  gsap.set(routeLit, { scaleX: 0 });
  signs.forEach((s) => gsap.set(s.wrap, { y: 90, opacity: 0, scaleY: 0.6 }));
  tl.from(signs.map((s) => s.node), { scale: 0, duration: 0.4, stagger: 0.08, ease: 'back.out(2)' }, 0.5);

  // signs rise as the dot reaches them
  let prev = 0.2;
  signs.forEach((s) => {
    const arrive = s.t + 0.15;
    const frac = (s.x - RX0) / (RX1 - RX0);
    tl.to(dot, { x: s.x - RX0, duration: arrive - prev, ease: 'power2.inOut' }, prev);
    tl.to(routeLit, { scaleX: frac, duration: arrive - prev, ease: 'power2.inOut' }, prev);
    tl.to(s.wrap, { y: 0, opacity: 1, scaleY: 1, duration: 0.7, ease: 'back.out(1.7)' }, s.t - 0.05);
    tl.to(s.node, { backgroundColor: '#4FD1C5', boxShadow: '0 0 20px rgba(79,209,197,.9)', duration: 0.3 }, arrive);
    tl.fromTo(s.ring, { scale: 0.4, opacity: 1 }, { scale: 2.2, opacity: 0, duration: 0.8, ease: 'power2.out', immediateRender: false }, arrive);
    prev = arrive + 0.1;
  });

  // "repetitive on paper": paper card flashes in, the stage dims
  tl.to(cam, { filter: 'brightness(0.45) blur(4px)', duration: 0.4 }, tRep - 0.15);
  tl.fromTo(flash, { opacity: 0 }, { opacity: 0.5, duration: 0.08, yoyo: true, repeat: 1, immediateRender: false }, tRep - 0.1);
  tl.fromTo(card, { opacity: 0, scale: 0.88, rotation: -2, y: 40 }, { opacity: 1, scale: 1, rotation: -1, y: 0, duration: 0.5, ease: 'back.out(1.6)', immediateRender: false }, tRep - 0.1);
  tl.to(card, { rotation: 0.5, duration: tAudio - tPaper, ease: 'sine.inOut' }, tPaper);

  // "In audio": the card drops away, the stage returns
  tl.to(card, { y: 260, opacity: 0, rotation: 4, duration: 0.55, ease: 'power2.in' }, tAudio - 0.3);
  tl.to(cam, { filter: 'brightness(1) blur(0px)', duration: 0.5 }, tAudio - 0.05);

  // "keeps people with you": the dot runs home and listeners follow, warming to amber
  const runDur = tYou - tKeeps + 0.1;
  tl.to(dot, { x: RX1 - RX0 - 6, duration: runDur, ease: 'power2.inOut' }, tKeeps);
  tl.to(routeLit, { scaleX: 1, duration: runDur, ease: 'power2.inOut' }, tKeeps);
  tl.to(endCap, { borderColor: '#FFB547', boxShadow: '0 0 30px rgba(255,181,71,.8)', duration: 0.4 }, tYou);
  tl.to(dot, { backgroundColor: '#fff3dc', boxShadow: '0 0 0 6px rgba(255,181,71,.4), 0 0 50px 14px rgba(255,181,71,.85)', duration: 0.5 }, tYou - 0.1);
  listeners.forEach((L) => {
    const st = tKeeps - 0.1 + L.i * 0.035;
    gsap.set(L.d, { x: RX0 - 80 + L.ox * 0.5, y: RY - 8 + L.oy });
    tl.to(L.d, { opacity: 1, duration: 0.3 }, st);
    tl.to(L.d, { x: RX1 - 70 + L.ox, y: RY - 8 + L.oy, duration: runDur + 0.35, ease: 'power2.inOut' }, st);
    tl.to(L.d, { backgroundColor: '#FFB547', boxShadow: '0 0 16px rgba(255,181,71,.8)', duration: 0.6 }, tPeople + L.i * 0.03);
  });
  signs.forEach((s, i) => tl.to(s.panel, { background: 'linear-gradient(180deg, #ffd38a, #FFB547)', duration: 0.4 }, tPeople + i * 0.12));

  // camera: slow drift, push in to land "you"
  tl.fromTo(cam, { scale: 1, x: 0 }, { scale: 1.025, x: -10, duration: tKeeps, ease: 'none', immediateRender: false }, 0);
  tl.to(cam, { scale: 1.08, x: -120, duration: ctx.dur - tKeeps, ease: 'expo.inOut' }, tKeeps);
});
