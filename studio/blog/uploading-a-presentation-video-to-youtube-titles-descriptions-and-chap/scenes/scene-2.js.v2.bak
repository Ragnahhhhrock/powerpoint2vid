/* Scene 2 — "A good title says what viewers will learn, in the words they'd type. So Q4 Webinar becomes
 * How to Plan a Q4 Marketing Budget for a Small Business."
 * Storyboard: ink stage, a large search bar pops in. On "words they'd type" a caret types a query into it.
 * On "Q4 Webinar" that phrase lands in slate at 140px and a signal-red strike slashes through it. On "becomes"
 * it dissolves letter by letter into the stronger title in paper white at 90px; "Q4 Marketing Budget" gets an
 * amber underline (topic near the start). The camera glides left to right along the new title and holds. */
P2V.scene((ctx) => {
  const { tl, el, stage } = ctx;
  const safe = (i, w, fb) => { const v = ctx.at(i, w); return Number.isFinite(v) ? v : fb; };
  const tWords = safe(0, 'words', 2.9), tType = safe(0, 'type', 4.0);
  const tQ4 = safe(1, 'Q4', 5.0), tWeb = safe(1, 'Webinar', 5.4), tBec = safe(1, 'becomes', 6.0);
  const tBud = safe(1, 'Budget', 7.9), tBiz = safe(1, 'Business', 9.0);
  const MONO = '600 22px/1 ui-monospace, Menlo, monospace';

  stage.style.background = 'radial-gradient(60% 55% at 50% 30%, #2a2f3a 0%, var(--ink) 55%, var(--night) 100%)';
  const glow = el('div', 'abs', stage, { inset: 0, background: 'radial-gradient(40% 35% at 50% 62%, rgba(246,243,238,.07), transparent 70%)' });
  const cam = el('div', 'abs', stage, { inset: 0, transformOrigin: '960px 560px' });

  const bar = el('div', 'abs', cam, { left: '360px', top: '150px', width: '1200px', height: '120px', borderRadius: '60px',
    background: 'linear-gradient(180deg, #2b303a, #22262e)', border: '2px solid rgba(255,255,255,.12)',
    boxShadow: '0 30px 80px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.08)' });
  const icon = el('div', 'abs', bar, { left: '44px', top: '34px', width: '52px', height: '52px' });
  icon.innerHTML = '<svg width="52" height="52" viewBox="0 0 52 52"><circle cx="22" cy="22" r="14" fill="none" stroke="#8A93A3" stroke-width="5"/><path d="M33 33 L46 46" stroke="#8A93A3" stroke-width="6" stroke-linecap="round"/></svg>';
  const qWrap = el('div', 'abs', bar, { left: '124px', top: '0', height: '116px', right: '60px', display: 'flex', alignItems: 'center', overflow: 'hidden' });
  const qText = el('span', '', qWrap, { font: '500 46px/1 Inter, sans-serif', letterSpacing: '-.01em', color: 'var(--paper)', whiteSpace: 'pre' });
  const caret = el('span', '', qWrap, { display: 'inline-block', width: '4px', height: '56px', marginLeft: '4px', background: '#E8392F' });
  const ph = el('div', 'abs', bar, { left: '124px', top: '0', height: '116px', display: 'flex', alignItems: 'center', font: '500 46px/1 Inter, sans-serif', color: 'rgba(138,147,163,.6)' });
  ph.textContent = 'Search';
  const barTag = el('div', 'abs', cam, { left: '400px', top: '104px', font: MONO, letterSpacing: '.14em', color: 'var(--slate)' });
  barTag.textContent = 'WHAT VIEWERS TYPE';
  const QUERY = 'how to plan a q4 marketing budget';
  const typing = { n: 0 };

  const oldRow = el('div', 'abs', cam, { left: '80px', width: '1760px', top: '520px', textAlign: 'center' });
  const oldIn = el('span', '', oldRow, { position: 'relative', display: 'inline-block', font: '800 140px/1.1 Inter Display, Inter, sans-serif', letterSpacing: '-.04em', color: 'var(--slate)' });
  const oldChars = ctx.split(oldIn, 'Q4 Webinar', 'char');
  const strike = el('div', 'abs', oldIn, { left: '-3%', width: '106%', top: '50%', height: '14px', marginTop: '-4px', borderRadius: '7px', background: '#E8392F', boxShadow: '0 0 30px rgba(232,57,47,.7)', transformOrigin: '0% 50%' });
  const weakTag = el('div', 'abs', cam, { left: '80px', width: '1760px', top: '476px', textAlign: 'center', font: MONO, letterSpacing: '.18em', color: '#E8392F' });
  weakTag.textContent = 'WEAK';

  const newBox = el('div', 'abs', cam, { left: '80px', width: '1760px', top: '470px', textAlign: 'center', font: '800 90px/1.12 Inter Display, Inter, sans-serif', letterSpacing: '-.04em', color: 'var(--paper)', textShadow: '0 0 40px rgba(246,243,238,.18)' });
  const newChars = [];
  const word = (parent, w) => {
    const s = el('span', '', parent, { display: 'inline-block', whiteSpace: 'nowrap' });
    [...w].forEach((c) => { const ch = el('span', '', s, { display: 'inline-block' }); ch.textContent = c; newChars.push(ch); });
    return s;
  };
  const sp = (parent) => el('span', '', parent, { display: 'inline-block', width: '.26em' });
  const l1 = el('div', '', newBox, {}), l2 = el('div', '', newBox, {});
  ['How', 'to', 'Plan', 'a'].forEach((w) => { word(l1, w); sp(l1); });
  const topic = el('span', '', l1, { position: 'relative', display: 'inline-block' });
  ['Q4', 'Marketing', 'Budget'].forEach((w, i) => { word(topic, w); if (i < 2) sp(topic); });
  const under = el('div', 'abs', topic, { left: '0', width: '100%', bottom: '-6px', height: '10px', borderRadius: '5px', background: '#F5A623', boxShadow: '0 0 26px rgba(245,166,35,.6)', transformOrigin: '0% 50%' });
  ['for', 'a', 'Small', 'Business'].forEach((w, i, a) => { word(l2, w); if (i < a.length - 1) sp(l2); });
  const strongTag = el('div', 'abs', cam, { left: '80px', width: '1760px', top: '420px', textAlign: 'center', font: MONO, letterSpacing: '.18em', color: 'var(--mint)' });
  strongTag.textContent = 'STRONGER';
  const topicTag = el('div', 'abs', cam, { left: '80px', width: '1760px', top: '730px', textAlign: 'center', font: MONO, letterSpacing: '.16em', color: '#F5A623' });
  topicTag.textContent = 'MAIN TOPIC · NEAR THE START';

  ctx.fx.vignette({ strength: 0.5 });
  ctx.fx.grain({ opacity: 0.06 });

  ctx.onFrame((t) => {
    const n = Math.round(typing.n);
    qText.textContent = QUERY.slice(0, n);
    ph.style.opacity = n > 0 ? 0 : 1;
    const typingNow = t > tWords - 0.1 && t < tType + 0.7;
    caret.style.opacity = typingNow || t < tWords ? (typingNow ? 1 : (Math.floor(t * 2.2) % 2 ? 0.15 : 1)) : (Math.floor(t * 2.2) % 2 ? 0 : 1);
  });

  gsap.set([oldIn, weakTag, strongTag, topicTag], { opacity: 0 });
  gsap.set(strike, { scaleX: 0 });
  gsap.set(under, { scaleX: 0 });
  gsap.set(newChars, { opacity: 0, y: 50, filter: 'blur(8px)' });
  gsap.set(oldChars, { filter: 'blur(0px)' });

  tl.fromTo(bar, { opacity: 0, scale: 0.92, y: 30 }, { opacity: 1, scale: 1, y: 0, duration: 0.7, ease: 'back.out(1.6)' }, 0.05);
  tl.fromTo(barTag, { opacity: 0, x: -20 }, { opacity: 1, x: 0, duration: 0.5 }, 0.35);
  tl.to(bar, { borderColor: 'rgba(245,166,35,.55)', duration: 0.4 }, tWords - 0.2);
  tl.to(typing, { n: QUERY.length, duration: Math.max(1, tType + 0.6 - tWords), ease: 'none' }, tWords - 0.1);

  const tOld = Math.min(tQ4 - 0.2, tWeb - 0.45);
  tl.to(oldIn, { opacity: 1, duration: 0.01 }, tOld);
  tl.fromTo(oldChars, { opacity: 0, y: 60, scale: 0.8 }, { opacity: 1, y: 0, scale: 1, duration: 0.45, stagger: 0.025, ease: 'back.out(1.8)', immediateRender: false }, tOld);
  tl.to(bar, { opacity: 0.45, scale: 0.94, y: -20, borderColor: 'rgba(255,255,255,.12)', duration: 0.6, ease: 'power2.inOut' }, tOld);
  tl.to(barTag, { opacity: 0.4, duration: 0.5 }, tOld);
  tl.to(weakTag, { opacity: 1, duration: 0.3 }, tOld + 0.2);
  const tS = Math.min(tWeb + 0.05, tBec - 0.45);
  tl.to(strike, { scaleX: 1, duration: 0.25, ease: 'power4.out' }, tS);
  tl.to(oldIn, { x: 8, duration: 0.05, yoyo: true, repeat: 3, ease: 'none' }, tS);

  const tM = tBec + 0.1;
  tl.to(strike, { opacity: 0, duration: 0.3 }, tM);
  tl.to(oldChars, { opacity: 0, y: -50, filter: 'blur(8px)', duration: 0.3, stagger: 0.015, ease: 'power2.in' }, tM);
  tl.to(weakTag, { opacity: 0, duration: 0.3 }, tM);
  tl.to(newChars, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.5, stagger: 0.022, ease: 'back.out(1.6)' }, tM + 0.4);
  tl.to(strongTag, { opacity: 1, duration: 0.4 }, tM + 0.6);

  const tU = Math.min(tBud + 0.15, ctx.dur - 2);
  tl.to(under, { scaleX: 1, duration: 0.55, ease: 'expo.out' }, tU);
  tl.fromTo(topicTag, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.5, ease: 'back.out(1.6)', immediateRender: false }, tU + 0.15);
  tl.to(under, { boxShadow: '0 0 50px rgba(245,166,35,.95)', duration: 0.4, yoyo: true, repeat: 1 }, Math.min(tBiz, ctx.dur - 1.5));

  tl.fromTo(cam, { x: 0, scale: 1 }, { x: -10, scale: 1.015, duration: tM, ease: 'none', immediateRender: false }, 0);
  tl.to(cam, { keyframes: [{ x: 34, scale: 1.04, duration: 0.9, ease: 'power2.out' }, { x: -34, scale: 1.05, duration: Math.max(1.5, ctx.dur - tM - 2.2), ease: 'power1.inOut' }] }, tM);
  tl.to(glow, { opacity: 1.6, duration: 1.2 }, tM);
});
