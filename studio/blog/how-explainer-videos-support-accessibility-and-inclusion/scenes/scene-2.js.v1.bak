/* Scene 2 — "But video isn't automatically accessible. Missing captions, low contrast, colour-only signals
 * and rushed pacing all shut people out. Each one is fixable at the slide and script stage."
 * Storyboard: night stage, headline "Not automatically accessible". Four tiles arrive one by one as each
 * barrier is named: an empty caption bar, grey-on-grey text, a red/green dot pair, a blurred fast-forward
 * arrow. Each tile has a coral outline, a warning icon and a label, so colour never carries the meaning alone.
 * On "fixable" a teal check slides over each tile in turn and the tile brightens and repairs itself.
 * The camera holds wide with only a very slight drift. Nothing flashes. */
P2V.scene((ctx) => {
  const { tl, el, stage } = ctx;
  const A = (i, w, fb) => { try { const v = ctx.at(i, w); if (typeof v === 'number' && isFinite(v)) return v; } catch (e) {} return fb; };
  const b1 = ctx.beats[1] ? ctx.beats[1].t : 3.63;
  const tCap = A(1, 'captions', b1 + 0.3);
  const tCon = A(1, 'contrast', tCap + 1.0);
  const tCol = A(1, 'colour-only', A(1, 'colour', tCon + 1.0));
  const tPac = A(1, 'pacing', A(1, 'rushed', tCol + 1.2));
  const tShut = A(1, 'shut', tPac + 0.8);
  const tFix = A(2, 'fixable', 10.4);
  const CORAL = '#E2604A', TEAL = '#1F8A8A', PAPER = '#F7F4EE', MIST = '#C9D3DE';
  const MONO = 'ui-monospace, Menlo, monospace';

  stage.style.background = 'radial-gradient(70% 60% at 50% 35%, #1b2a42 0%, var(--night) 70%)';
  const cam = el('div', 'abs', stage, { inset: 0, transformOrigin: '960px 560px' });
  el('div', 'abs', cam, { left: '260px', top: '300px', width: '1400px', height: '700px', background: 'radial-gradient(50% 50% at 50% 50%, rgba(31,138,138,.10), transparent 70%)' });

  const head = el('div', 'abs', cam, { left: '80px', width: '1760px', top: '120px', textAlign: 'center', font: '800 100px/1 Inter Display, Inter', letterSpacing: '-.04em', color: PAPER });
  head.textContent = 'Not automatically accessible';
  const rule = el('div', 'abs', cam, { left: '860px', width: '200px', top: '262px', height: '4px', borderRadius: '2px', background: CORAL, transformOrigin: '50% 50%' });

  const LABELS = ['No captions', 'Low contrast', 'Colour only', 'Rushed pacing'];
  const W = 380, GAP = 40, X0 = (1920 - (4 * W + 3 * GAP)) / 2, TOP = 360, H = 470;

  const tiles = LABELS.map((lab, i) => {
    const tile = el('div', 'abs', cam, { left: X0 + i * (W + GAP) + 'px', top: TOP + 'px', width: W + 'px', height: H + 'px', borderRadius: '24px',
      background: 'rgba(255,255,255,.04)', border: '3px solid ' + CORAL, boxShadow: '0 30px 70px rgba(0,0,0,.45)', boxSizing: 'border-box' });
    const vis = el('div', 'abs', tile, { left: '27px', top: '27px', width: '320px', height: '270px', borderRadius: '14px', overflow: 'hidden', background: '#0a1220' });
    const label = el('div', 'abs', tile, { left: '20px', width: W - 46 + 'px', top: '330px', textAlign: 'center', font: `700 26px/1.2 ${MONO}`, letterSpacing: '.12em', textTransform: 'uppercase', color: MIST });
    label.textContent = lab;
    const bar = el('div', 'abs', tile, { left: '120px', width: '134px', top: '392px', height: '4px', borderRadius: '2px', background: CORAL });
    // warning badge (shape + symbol, not colour alone)
    const warn = el('div', 'abs', tile, { right: '-30px', top: '-30px', width: '68px', height: '68px' });
    warn.innerHTML = `<svg width="68" height="68" viewBox="0 0 68 68"><circle cx="34" cy="34" r="32" fill="${CORAL}" stroke="#0F1A2B" stroke-width="4"/><path d="M34 16 L52 48 L16 48 Z" fill="none" stroke="#fff" stroke-width="4" stroke-linejoin="round"/><path d="M34 27 V38" stroke="#fff" stroke-width="4" stroke-linecap="round"/><circle cx="34" cy="43.5" r="2.4" fill="#fff"/></svg>`;
    const check = el('div', 'abs', tile, { right: '-30px', top: '-30px', width: '68px', height: '68px' });
    check.innerHTML = `<svg width="68" height="68" viewBox="0 0 68 68"><circle cx="34" cy="34" r="32" fill="${TEAL}" stroke="#0F1A2B" stroke-width="4"/><path d="M20 35 L30 45 L49 24" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    // sweeping teal check band
    const sweep = el('div', 'abs', tile, { left: 0, top: 0, width: '100%', height: '100%', borderRadius: '21px', overflow: 'hidden', pointerEvents: 'none' });
    const band = el('div', 'abs', sweep, { left: '-160px', top: '-40px', width: '120px', height: '560px', transform: 'rotate(14deg)', background: 'linear-gradient(90deg, transparent, rgba(31,138,138,.35), transparent)' });
    return { tile, vis, label, bar, warn, check, band };
  });

  /* tile 1: video frame, empty caption bar */
  const v0 = tiles[0].vis;
  el('div', 'abs', v0, { left: '130px', top: '50px', width: '60px', height: '60px', borderRadius: '50%', background: 'rgba(201,211,222,.35)' });
  el('div', 'abs', v0, { left: '105px', top: '118px', width: '110px', height: '70px', borderRadius: '50px 50px 8px 8px', background: 'rgba(201,211,222,.35)' });
  const capBox = el('div', 'abs', v0, { left: '30px', top: '200px', width: '260px', height: '50px', borderRadius: '8px', border: '2px dashed rgba(201,211,222,.5)', boxSizing: 'border-box' });
  const capLines = [[20, 12, 220], [60, 30, 140]].map(([l, tp, w]) => el('div', 'abs', capBox, { left: l + 'px', top: tp - 6 + 'px', width: w + 'px', height: '8px', borderRadius: '4px', background: PAPER, transformOrigin: '0 50%' }));

  /* tile 2: grey-on-grey */
  const v1 = tiles[1].vis; v1.style.background = '#4a5260';
  const aa = el('div', 'abs', v1, { left: '40px', top: '40px', font: '800 120px/1 Inter', letterSpacing: '-.04em', color: '#58606e' }); aa.textContent = 'Aa';
  const gl = [[40, 190, 240], [40, 218, 180]].map(([l, tp, w]) => el('div', 'abs', v1, { left: l + 'px', top: tp + 'px', width: w + 'px', height: '12px', borderRadius: '6px', background: '#58606e' }));

  /* tile 3: red/green dots */
  const v2 = tiles[2].vis;
  const dots = [['#c94a3c', 60, '✕'], ['#4f9a4c', 170, '✓']].map(([c, l, s]) => {
    const d = el('div', 'abs', v2, { left: l + 'px', top: '85px', width: '96px', height: '96px', borderRadius: '50%', background: c, display: 'flex', alignItems: 'center', justifyContent: 'center' });
    const sym = el('div', '', d, { font: '800 54px/1 Inter', color: '#fff' }); sym.textContent = s;
    return sym;
  });

  /* tile 4: blurred fast-forward */
  const v3 = tiles[3].vis;
  const ff = el('div', 'abs', v3, { left: 0, top: 0, width: '320px', height: '270px' });
  ff.innerHTML = `<svg width="320" height="270"><g fill="${MIST}"><path d="M110 85 L170 135 L110 185 Z"/><path d="M170 85 L230 135 L170 185 Z"/></g></svg>`;
  const streaks = el('div', 'abs', v3, { left: 0, top: 0, width: '320px', height: '270px' });
  streaks.innerHTML = `<svg width="320" height="270"><g stroke="${MIST}" stroke-width="5" stroke-linecap="round" opacity=".5"><path d="M30 100 H95"/><path d="M15 135 H95"/><path d="M40 170 H95"/></g></svg>`;
  gsap.set(ff, { filter: 'blur(7px)', x: 0 });

  ctx.fx.vignette({ strength: 0.5 });
  ctx.fx.grain({ opacity: 0.06 });

  /* ---- timeline ---- */
  gsap.set(tiles.map((t) => t.tile), { filter: 'brightness(0.85)' });
  gsap.set(tiles.map((t) => t.check), { opacity: 0, x: -70 });
  gsap.set(capLines, { scaleX: 0 });
  gsap.set(dots, { opacity: 0 });

  tl.fromTo(head, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 1.1, ease: 'power2.inOut' }, 0.05);
  tl.fromTo(rule, { scaleX: 0 }, { scaleX: 1, duration: 1.0, ease: 'power2.inOut' }, 0.6);
  tl.fromTo(cam, { scale: 1 }, { scale: 1.02, duration: ctx.dur, ease: 'none' }, 0);

  [tCap, tCon, tCol, tPac].forEach((t, i) => {
    const T = tiles[i];
    tl.fromTo(T.tile, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.9, ease: 'power2.out' }, t - 0.25);
    tl.fromTo(T.warn, { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.6, ease: 'back.out(1.6)' }, t + 0.2);
  });
  // "shut people out": tiles settle slightly dimmer
  tl.to(tiles.map((t) => t.tile), { filter: 'brightness(0.72)', duration: 1.0, ease: 'power2.inOut' }, tShut);

  // "fixable": teal check slides over each tile, tile brightens and repairs
  tiles.forEach((T, i) => {
    const t = tFix - 0.1 + i * 0.4;
    tl.fromTo(T.band, { x: 0 }, { x: 620, duration: 1.0, ease: 'power2.inOut' }, t);
    tl.to(T.check, { opacity: 1, x: 0, duration: 0.7, ease: 'back.out(1.4)' }, t + 0.15);
    tl.to(T.warn, { opacity: 0, duration: 0.4, ease: 'power2.inOut' }, t + 0.3);
    tl.to(T.tile, { borderColor: TEAL, backgroundColor: 'rgba(255,255,255,.09)', filter: 'brightness(1.08)', duration: 0.8, ease: 'power2.inOut' }, t + 0.2);
    tl.to(T.bar, { backgroundColor: TEAL, duration: 0.8, ease: 'power2.inOut' }, t + 0.2);
    tl.to(T.label, { color: PAPER, duration: 0.8 }, t + 0.2);
  });
  const fx = (i) => tFix + 0.25 + i * 0.4;
  tl.to(capBox, { borderColor: 'rgba(247,244,238,.0)', backgroundColor: 'rgba(0,0,0,.6)', duration: 0.6 }, fx(0));
  tl.to(capLines, { scaleX: 1, duration: 0.7, stagger: 0.12, ease: 'power2.out' }, fx(0));
  tl.to(tiles[1].vis, { backgroundColor: '#16202E', duration: 0.7 }, fx(1));
  tl.to([aa], { color: PAPER, duration: 0.7 }, fx(1));
  tl.to(gl, { backgroundColor: MIST, duration: 0.7 }, fx(1));
  tl.to(dots, { opacity: 1, duration: 0.6, stagger: 0.1 }, fx(2));
  tl.to(ff, { filter: 'blur(0px)', duration: 0.9, ease: 'power2.inOut' }, fx(3));
  tl.to(streaks, { opacity: 0, duration: 0.7 }, fx(3));
  tl.to(rule, { backgroundColor: TEAL, duration: 1.0, ease: 'power2.inOut' }, tFix + 1.2);
});
