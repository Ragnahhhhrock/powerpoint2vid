/* Scene 2 — "Text alone asks a lot of the reader. Video spreads the load across voice and image,
 * and lets people pause, rewind and rewatch whenever they need."
 * Storyboard: warm paper stage. A heavy ink block labelled 'Text' balances on one narrow column and
 * sags on "asks a lot". On "spreads the load" teal 'Voice' and sun 'Image' pillars rise. The block
 * splits, settles level across them and stays there. On "pause", "rewind" and "rewatch" three large
 * playback icons click in one by one. A softly glowing caption strip settles beneath them.
 * Headline 'Spread the load' sits top-left. Calm, unhurried easing with no flashes. */
P2V.scene((ctx) => {
  const { tl, el, stage } = ctx;
  const T = (i, w, fb) => { const v = ctx.at(i, w); return (typeof v === 'number' && isFinite(v)) ? v : fb; };
  const asks = T(0, 'asks', 1.5);
  const spreads = T(1, 'spreads', 3.3);
  const voice = T(1, 'voice', 4.6);
  const image = T(1, 'image', 5.1);
  const pause = T(1, 'pause', 6.6);
  const rewind = T(1, 'rewind', 7.1);
  const rewatch = T(1, 'rewatch', 7.7);
  const need = T(1, 'need', 8.8);

  const mono = '600 20px/1 ui-monospace, Menlo, monospace';
  stage.style.background = 'radial-gradient(70% 70% at 55% 45%, #fffdf8 0%, var(--paper) 55%, #ebe5da 100%)';
  const cam = el('div', 'abs', stage, { inset: 0, transformOrigin: '960px 560px' });

  /* headline */
  const head = el('div', 'abs', cam, { left: '120px', top: '90px', font: '800 110px/1 Inter Display, Inter', letterSpacing: '-.045em', color: 'var(--ink)', whiteSpace: 'nowrap' });
  head.textContent = 'Spread the load';
  const tag = el('div', 'abs', cam, { left: '126px', top: '222px', font: mono, letterSpacing: '.14em', color: 'var(--teal)' });
  tag.textContent = 'VIDEO · MORE THAN ONE CHANNEL';

  /* ground + structure */
  const GROUND = 660;
  el('div', 'abs', cam, { left: '440px', width: '1040px', top: GROUND + 'px', height: '3px', borderRadius: '2px', background: 'linear-gradient(90deg, transparent, rgba(22,32,46,.35), transparent)' });
  const shadow = el('div', 'abs', cam, { left: '760px', width: '400px', top: GROUND - 6 + 'px', height: '20px', borderRadius: '50%', background: 'radial-gradient(closest-side, rgba(22,32,46,.22), transparent)' });

  const column = el('div', 'abs', cam, { left: '935px', top: '470px', width: '50px', height: GROUND - 470 + 'px', borderRadius: '6px 6px 2px 2px', background: 'linear-gradient(90deg, #8b96a3, #c9d3de 50%, #8b96a3)', transformOrigin: '50% 100%', boxShadow: '0 10px 30px rgba(22,32,46,.18)' });

  const mkPillar = (left, col, col2) => el('div', 'abs', cam, { left: left + 'px', top: '470px', width: '180px', height: GROUND - 470 + 'px', borderRadius: '10px 10px 3px 3px', background: `linear-gradient(90deg, ${col2}, ${col} 45%, ${col2})`, transformOrigin: '50% 100%', boxShadow: '0 20px 50px rgba(22,32,46,.18)' });
  const pV = mkPillar(610, '#2aa3a3', 'var(--teal)');
  const pI = mkPillar(1130, '#f7c76a', 'var(--sun)');

  const blockStyle = (left, radius) => ({ left: left + 'px', top: '320px', width: '270px', height: '150px', borderRadius: radius, background: 'linear-gradient(180deg, #2a3648, var(--ink))', boxShadow: '0 30px 60px rgba(22,32,46,.28), inset 0 1px 0 rgba(255,255,255,.12)' });
  const halfL = el('div', 'abs', cam, { ...blockStyle(690, '18px 0 0 18px'), transformOrigin: '100% 100%' });
  const halfR = el('div', 'abs', cam, { ...blockStyle(960, '0 18px 18px 0'), transformOrigin: '0% 100%' });
  const textLab = el('div', 'abs', cam, { left: '690px', width: '540px', top: '355px', textAlign: 'center', font: '800 72px/1 Inter Display, Inter', letterSpacing: '-.03em', color: 'var(--paper)', transformOrigin: '50% 100%' });
  textLab.textContent = 'Text';

  const lab = (parent, txt, col) => {
    const d = el('div', 'abs', parent, { inset: 0, display: 'flex', alignItems: 'center', justifyContent: 'center', font: '800 54px/1 Inter Display, Inter', letterSpacing: '-.03em', color: col });
    d.textContent = txt; return d;
  };
  const vLab = lab(halfL, 'Voice', '#7fd6d6');
  const iLab = lab(halfR, 'Image', 'var(--sun)');

  /* playback icons */
  const ICONS = [
    ['PAUSE', '<rect x="34" y="30" width="18" height="60" rx="4" fill="#F7F4EE"/><rect x="68" y="30" width="18" height="60" rx="4" fill="#F7F4EE"/>'],
    ['REWIND', '<path d="M60 32 L26 60 L60 88 Z M96 32 L62 60 L96 88 Z" fill="#F7F4EE"/>'],
    ['REWATCH', '<path d="M86 46 A30 30 0 1 0 90 66" fill="none" stroke="#F7F4EE" stroke-width="10" stroke-linecap="round"/><path d="M74 30 L94 44 L72 56 Z" fill="#F7F4EE"/>'],
  ];
  const icons = ICONS.map(([name, svg], i) => {
    const cx = 760 + i * 200;
    const wrap = el('div', 'abs', cam, { left: cx - 60 + 'px', top: '712px', width: '120px', height: '120px', borderRadius: '50%', background: 'var(--ink)', boxShadow: '0 18px 40px rgba(22,32,46,.25)' });
    wrap.innerHTML = `<svg width="120" height="120" viewBox="0 0 120 120">${svg}</svg>`;
    const l = el('div', 'abs', cam, { left: cx - 100 + 'px', width: '200px', top: '850px', textAlign: 'center', font: '600 18px/1 ui-monospace, Menlo, monospace', letterSpacing: '.16em', color: 'rgba(22,32,46,.7)' });
    l.textContent = name;
    return { wrap, l };
  });

  /* caption strip */
  const strip = el('div', 'abs', cam, { left: '560px', width: '800px', top: '904px', height: '70px', borderRadius: '14px', background: 'rgba(22,32,46,.92)', display: 'flex', alignItems: 'center', gap: '20px', padding: '0 26px', boxSizing: 'border-box', boxShadow: '0 0 0 rgba(242,181,68,0)' });
  const cc = el('div', '', strip, { font: '800 20px/1 Inter', color: 'var(--ink)', background: 'var(--sun)', borderRadius: '6px', padding: '7px 10px', flex: 'none' });
  cc.textContent = 'CC';
  const capTxt = el('div', '', strip, { font: '600 28px/1 Inter', color: 'var(--paper)', whiteSpace: 'nowrap', letterSpacing: '-.01em' });
  capTxt.textContent = '…whenever they need.';

  ctx.fx.vignette({ strength: 0.22 });
  ctx.fx.grain({ opacity: 0.05 });

  /* ---- timeline ---- */
  gsap.set([pV, pI], { scaleY: 0 });
  gsap.set([vLab, iLab], { opacity: 0 });
  icons.forEach((o) => gsap.set([o.wrap, o.l], { opacity: 0 }));
  gsap.set(strip, { opacity: 0, y: 24 });

  tl.from(head, { opacity: 0, y: 24, duration: 0.9, ease: 'power2.out' }, 0.05);
  tl.from(tag, { opacity: 0, duration: 0.8, ease: 'sine.inOut' }, 0.4);
  tl.from([column, shadow], { opacity: 0, duration: 0.7, ease: 'sine.out' }, 0.1);
  tl.from([halfL, halfR, textLab], { opacity: 0, y: -40, duration: 0.9, ease: 'power2.out' }, 0.2);

  // "asks a lot": the block sags and the column strains
  tl.to(halfL, { rotation: -9, duration: 1.2, ease: 'sine.inOut' }, asks - 0.2);
  tl.to(halfR, { rotation: 9, duration: 1.2, ease: 'sine.inOut' }, asks - 0.2);
  tl.to(textLab, { y: 14, duration: 1.2, ease: 'sine.inOut' }, asks - 0.2);
  tl.to(column, { scaleY: 0.93, scaleX: 1.12, duration: 1.2, ease: 'sine.inOut' }, asks - 0.2);

  // "spreads the load": pillars rise, the block splits and levels
  tl.to(pV, { scaleY: 1, duration: 1.0, ease: 'power2.inOut' }, spreads - 0.2);
  tl.to(pI, { scaleY: 1, duration: 1.0, ease: 'power2.inOut' }, spreads - 0.05);
  tl.to(textLab, { opacity: 0, duration: 0.5, ease: 'sine.inOut' }, spreads);
  tl.to(halfL, { x: 565 - 690, rotation: 0, borderRadius: '18px', duration: 1.3, ease: 'power2.inOut' }, spreads + 0.25);
  tl.to(halfR, { x: 1085 - 960, rotation: 0, borderRadius: '18px', duration: 1.3, ease: 'power2.inOut' }, spreads + 0.25);
  tl.to([column, shadow], { opacity: 0, duration: 0.8, ease: 'sine.inOut' }, spreads + 0.3);
  tl.to(vLab, { opacity: 1, duration: 0.6, ease: 'sine.out' }, Math.max(spreads + 1.2, voice - 0.1));
  tl.to(iLab, { opacity: 1, duration: 0.6, ease: 'sine.out' }, Math.max(spreads + 1.4, image - 0.1));

  // pause, rewind, rewatch: icons click in one by one
  [pause, rewind, rewatch].forEach((t, i) => {
    const o = icons[i];
    tl.fromTo(o.wrap, { opacity: 0, scale: 0.7, y: 20 }, { opacity: 1, scale: 1, y: 0, duration: 0.6, ease: 'back.out(1.6)', immediateRender: false }, t - 0.12);
    tl.to(o.l, { opacity: 1, duration: 0.5, ease: 'sine.out' }, t + 0.05);
  });

  // caption strip settles and glows softly
  const capT = Math.min(rewatch + 0.5, ctx.dur - 2);
  tl.to(strip, { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, capT);
  tl.to(strip, { boxShadow: '0 0 50px rgba(242,181,68,.45)', duration: 1.2, ease: 'sine.inOut' }, Math.min(need - 0.3, ctx.dur - 1.3));

  // slow camera drift throughout
  tl.fromTo(cam, { scale: 1, x: 10 }, { scale: 1.035, x: -14, duration: ctx.dur, ease: 'sine.inOut', immediateRender: false }, 0);
});
